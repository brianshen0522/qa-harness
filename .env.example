# ---- API ----
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://qa:qa@localhost:5433/qa_harness?schema=public
REDIS_URL=redis://localhost:6380

# Session / JWT
USER_JWT_SECRET=change-me-user-secret
ADMIN_JWT_SECRET=change-me-admin-secret
COOKIE_SECURE=false

# AES-256-GCM master key: 32 bytes, base64 (generate: openssl rand -base64 32)
CREDENTIAL_MASTER_KEY=

# OAuth (users). Leave blank to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:3001

# Dev-only: allow POST /auth/dev-login { email, name } without OAuth
DEV_LOGIN_ENABLED=true

# Initial admin (created on seed if not exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Object storage (unused until run execution)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=qa-harness
