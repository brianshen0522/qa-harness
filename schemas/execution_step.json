{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-harness/execution_step",
  "title": "execution_step",
  "description": "One agent step while executing a test case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "observation",
    "intent",
    "action"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "phase": {
      "type": "string",
      "enum": [
        "setup",
        "executing",
        "verifying",
        "judging"
      ]
    },
    "observation": {
      "type": "string",
      "description": "畫面上實際看到什麼：元素、文字、目前狀態。必填，每一步都要重寫。"
    },
    "intent": {
      "type": "string",
      "description": "這一步想達成什麼。"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "params"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "screenshot",
            "click",
            "double_click",
            "right_click",
            "type",
            "key",
            "scroll",
            "move",
            "wait",
            "http_request",
            "navigate",
            "run_command",
            "mcp_call",
            "report_finding",
            "done"
          ],
          "description": "要執行的動作。`report_finding` 用來記下與目前 case 無關的問題，記完會繼續原本的流程；`mcp_call` 呼叫外部 MCP 工具（params 給 server_id、tool、arguments）；`done` 結束這條 case。"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "description": "依據上面的觀察決定的下一個動作。"
    }
  }
}