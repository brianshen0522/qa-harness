{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-harness/test_case",
  "title": "test_case",
  "description": "Generation pipeline step 2: test cases for one feature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_ref", "title", "precondition", "steps", "expected", "priority", "type"],
        "properties": {
          "feature_ref": { "type": "string", "description": "Feature name this case belongs to." },
          "title": { "type": "string", "minLength": 1 },
          "precondition": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expected": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "type": { "type": "string", "enum": ["happy", "edge", "negative"] }
        }
      }
    }
  }
}
