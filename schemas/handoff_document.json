{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-harness/handoff_document",
  "title": "handoff_document",
  "description": "Parsed representation of a coding-agent handoff document (markdown with YAML front-matter).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "front_matter", "sections"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "front_matter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["harness_version", "scope", "generated_at"],
      "properties": {
        "harness_version": { "type": "string" },
        "scope": { "type": "string", "enum": ["project", "target"] },
        "target_kind": { "type": ["string", "null"], "enum": ["api", "web", "desktop", null] },
        "generated_at": { "type": "string" }
      }
    },
    "sections": {
      "type": "object",
      "description": "Section title -> markdown body. Known titles are imported structurally; unknown ones are kept as description text.",
      "additionalProperties": { "type": "string" }
    },
    "suggested_test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "feature": { "type": "string" },
          "title": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "expected": { "type": "string" }
        }
      }
    },
    "detected_secrets": {
      "type": "array",
      "description": "Keys that look like credentials found in the document; user is prompted to move them to encrypted storage.",
      "items": { "type": "string" }
    }
  }
}
