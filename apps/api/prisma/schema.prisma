generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

enum UserStatus {
  active
  disabled
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  authProvider String     @map("auth_provider")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  targetMemberships  TargetMember[]
  createdProjects    Project[]

  @@map("users")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// ---------- Team / Project ----------

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members  TeamMember[]
  projects Project[]

  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

enum Role {
  viewer
  editor
  owner
}

enum DescriptionSource {
  manual
  discussion
  handoff
}

model Project {
  id                 String   @id @default(uuid())
  teamId             String   @map("team_id")
  name               String
  description        String   @default("")
  descriptionVersion Int      @default(0) @map("description_version")
  createdById        String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  team                Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy           User                        @relation(fields: [createdById], references: [id])
  members             ProjectMember[]
  targets             QaTarget[]
  descriptionVersions ProjectDescriptionVersion[]
  discussion          Discussion?
  attachments         ProjectAttachment[]
  handoffDocuments    HandoffDocument[]

  @@map("projects")
}

model ProjectDescriptionVersion {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  version   Int
  content   String
  source    DescriptionSource
  createdBy String            @map("created_by")
  createdAt DateTime          @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@map("project_description_versions")
}

model ProjectMember {
  projectId String @map("project_id")
  userId    String @map("user_id")
  role      Role

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

// ---------- QA Target ----------

enum TargetKind {
  api
  web
  desktop
}

enum TargetStatus {
  idle
  running
}

model QaTarget {
  id                 String       @id @default(uuid())
  projectId          String       @map("project_id")
  name               String
  kind               TargetKind
  config             Json         @default("{}")
  description        String       @default("")
  descriptionVersion Int          @default(0) @map("description_version")
  status             TargetStatus @default(idle)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentials      TargetCredential[]
  members          TargetMember[]
  discussion       Discussion?
  handoffDocuments HandoffDocument[]
  features         Feature[]
  testCases        TestCase[]
  generationRuns   GenerationRun[]
  testRuns         TestRun[]

  @@map("qa_targets")
}

model TargetCredential {
  targetId       String @map("target_id")
  key            String
  encryptedValue String @map("encrypted_value")

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([targetId, key])
  @@map("qa_target_credentials")
}

/// Role override — only ever >= the member's project role (enforced in service layer).
model TargetMember {
  targetId String @map("target_id")
  userId   String @map("user_id")
  role     Role

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([targetId, userId])
  @@map("qa_target_members")
}

// ---------- LLM ----------

enum LlmProvider {
  anthropic
  openai
  ollama
}

enum LlmPurpose {
  discuss
  generate
  execute
}

/// Circuit-breaker state. `down` configs are skipped when picking a chain and
/// are re-probed on a schedule until they answer again.
enum LlmHealth {
  healthy
  degraded
  down
}

model LlmConfig {
  id              String       @id @default(uuid())
  name            String
  provider        LlmProvider
  endpoint        String?
  apiKeyEncrypted String?      @map("api_key")
  model           String
  purposes        LlmPurpose[]
  supportsVision  Boolean      @default(false) @map("supports_vision")
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  health              LlmHealth @default(healthy)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  downSince           DateTime? @map("down_since")
  lastFailureAt       DateTime? @map("last_failure_at")
  lastFailureKind     String?   @map("last_failure_kind")
  lastFailureMessage  String?   @map("last_failure_message")
  lastProbeAt         DateTime? @map("last_probe_at")
  /// Probes back off while a config stays down; reset the moment it recovers.
  nextProbeAt         DateTime? @map("next_probe_at")
  probeAttempts       Int       @default(0) @map("probe_attempts")
  lastRecoveredAt     DateTime? @map("last_recovered_at")

  fallbackEntries LlmFallbackChain[]

  @@map("llm_configs")
}

model LlmFallbackChain {
  purpose     LlmPurpose
  llmConfigId String     @map("llm_config_id")
  order       Int

  llmConfig LlmConfig @relation(fields: [llmConfigId], references: [id], onDelete: Cascade)

  @@id([purpose, llmConfigId])
  @@map("llm_fallback_chains")
}

/// One row per LLM call, for usage accounting and debugging fallbacks.
model LlmCallLog {
  id           String     @id @default(uuid())
  purpose      LlmPurpose
  schemaName   String?    @map("schema_name")
  llmConfigId  String?    @map("llm_config_id")
  model        String
  attempt      Int
  outcome      String // ok | invalid_output | provider_error | timeout | rate_limit
  errorMessage String?    @map("error_message")
  rawOutput    String?    @map("raw_output")
  inputTokens  Int?       @map("input_tokens")
  outputTokens Int?       @map("output_tokens")
  durationMs   Int        @map("duration_ms")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("llm_call_logs")
}

// ---------- Sandbox / Audit ----------

model SandboxSettings {
  id              Int    @id @default(1)
  image           String @default("qa-harness-sandbox:0.1")
  cpu             Float  @default(2)
  memoryMb        Int    @default(4096) @map("memory_mb")
  resolution      String @default("1280x800")
  maxConcurrent   Int    @default(2) @map("max_concurrent")
  maxStepsPerCase Int    @default(60) @map("max_steps_per_case")
  stepTimeoutSec  Int    @default(60) @map("step_timeout")
  retentionDays   Int    @default(30) @map("retention_days")

  @@map("sandbox_settings")
}

enum ActorType {
  admin
  user
}

model AuditLog {
  id        String    @id @default(uuid())
  actorType ActorType @map("actor_type")
  actorId   String    @map("actor_id")
  action    String
  target    String?
  payload   Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Discussion (§4.1) ----------

enum Scope {
  project
  target
}

enum DiscussionRole {
  user
  assistant
}

/// One guided-discussion thread per Project and per Target.
model Discussion {
  id           String   @id @default(uuid())
  scope        Scope
  projectId    String?  @unique @map("project_id")
  targetId     String?  @unique @map("target_id")
  /// { checklistItemKey: "unknown" | "partial" | "clear" }
  completeness Json     @default("{}")
  /// Working description draft, editable by the user and patched by the LLM.
  draft        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project   Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target    QaTarget?           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  messages  DiscussionMessage[]
  proposals TargetProposal[]

  @@map("discussions")
}

model DiscussionMessage {
  id           String         @id @default(uuid())
  discussionId String         @map("discussion_id")
  role         DiscussionRole
  content      String
  /// Full `discussion_turn` payload for assistant messages.
  structured   Json?
  /// URLs fetched for this message: [{ url, title, chars, error }]
  references   Json?
  llmConfigId  String?        @map("llm_config_id")
  model        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId, createdAt])
  @@map("discussion_messages")
}

enum ProposalStatus {
  pending
  accepted
  rejected
}

/// LLM-suggested QA Target. Never applied automatically — a user must accept it.
model TargetProposal {
  id              String         @id @default(uuid())
  discussionId    String         @map("discussion_id")
  messageId       String?        @map("message_id")
  kind            TargetKind
  name            String
  config          Json           @default("{}")
  credentialKeys  String[]       @map("credential_keys")
  rationale       String         @default("")
  status          ProposalStatus @default(pending)
  createdTargetId String?        @map("created_target_id")
  decidedById     String?        @map("decided_by")
  decidedAt       DateTime?      @map("decided_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@map("target_proposals")
}

enum AttachmentSource {
  url
  file
  handoff
}

/// Reference material gathered in the discussion area (§4.1).
model ProjectAttachment {
  id           String           @id @default(uuid())
  projectId    String           @map("project_id")
  sourceType   AttachmentSource @map("source_type")
  filename     String
  mime         String           @default("text/plain")
  url          String?
  storageKey   String?          @map("storage_key")
  /// Extracted text, used as LLM context.
  textContent  String?          @map("text_content")
  byteSize     Int              @default(0) @map("byte_size")
  uploadedById String           @map("uploaded_by")
  createdAt    DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_attachments")
}

// ---------- Context Handoff (§4.2) ----------

enum HandoffApplyMode {
  overwrite
  merge
  attachment
}

model HandoffDocument {
  id                          String           @id @default(uuid())
  scope                       Scope
  projectId                   String?          @map("project_id")
  targetId                    String?          @map("target_id")
  rawContent                  String           @map("raw_content")
  /// Parsed `handoff_document` payload (front-matter + sections + extras).
  parsed                      Json
  harnessVersion              String           @map("harness_version")
  applyMode                   HandoffApplyMode @map("apply_mode")
  importedById                String           @map("imported_by")
  importedAt                  DateTime         @default(now()) @map("imported_at")
  appliedToDescriptionVersion Int?             @map("applied_to_description_version")

  project Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  QaTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([projectId, importedAt])
  @@index([targetId, importedAt])
  @@map("handoff_documents")
}

// ---------- Features & test cases (§4.3) ----------

enum FeatureStatus {
  active
  removed
}

model Feature {
  id                        String        @id @default(uuid())
  targetId                  String        @map("target_id")
  name                      String
  description               String        @default("")
  status                    FeatureStatus @default(active)
  /// Description version this feature was derived from, so staleness is visible.
  basedOnDescriptionVersion Int           @default(0) @map("based_on_description_version")
  order                     Int           @default(0)
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  target    QaTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  findings  RunFinding[]

  @@unique([targetId, name])
  @@index([targetId, order])
  @@map("features")
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum CaseType {
  happy
  edge
  negative
}

enum CaseSource {
  generated
  manual
  change_proposal
}

/// active runs by default; outdated needs review after a change; deprecated is history.
enum CaseStatus {
  active
  outdated
  deprecated
}

model TestCase {
  id                        String     @id @default(uuid())
  targetId                  String     @map("target_id")
  featureId                 String?    @map("feature_id")
  title                     String
  precondition              String     @default("")
  /// string[] — the steps an executor follows.
  steps                     Json       @default("[]")
  expected                  String
  priority                  Priority   @default(P2)
  type                      CaseType   @default(happy)
  source                    CaseSource @default(generated)
  status                    CaseStatus @default(active)
  currentVersion            Int        @default(1) @map("current_version")
  order                     Int        @default(0)
  basedOnDescriptionVersion Int        @default(0) @map("based_on_description_version")
  createdById               String?    @map("created_by")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  target    QaTarget          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  feature   Feature?          @relation(fields: [featureId], references: [id], onDelete: SetNull)
  versions  TestCaseVersion[]
  queueRows RunCaseQueue[]
  results   TestResult[]

  @@index([targetId, order])
  @@index([featureId])
  @@map("test_cases")
}

model TestCaseVersion {
  id         String   @id @default(uuid())
  testCaseId String   @map("test_case_id")
  version    Int
  /// Full snapshot of the case at this version.
  content    Json
  changeId   String?  @map("change_id")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, version])
  @@map("test_case_versions")
}

// ---------- Generation pipeline (§4.3) ----------

enum GenerationStatus {
  running
  /// Waiting for an LLM to come back; resumes on its own.
  paused
  succeeded
  failed
}

enum GenerationMode {
  replace
  append
}

model GenerationRun {
  id                 String           @id @default(uuid())
  targetId           String           @map("target_id")
  status             GenerationStatus @default(running)
  mode               GenerationMode
  descriptionVersion Int              @map("description_version")
  featureCount       Int              @default(0) @map("feature_count")
  caseCount          Int              @default(0) @map("case_count")
  duplicatesDropped  Int              @default(0) @map("duplicates_dropped")
  /// Summary of what 現況探索 found, shown in the UI.
  discovery          Json?
  model              String?
  error              String?
  /// Why the run is paused, shown to the user while it waits.
  pausedReason       String?          @map("paused_reason")
  pausedAt           DateTime?        @map("paused_at")
  /// Partial results, so a paused run picks up where it stopped.
  progress           Json?
  triggeredById      String           @map("triggered_by")
  startedAt          DateTime         @default(now()) @map("started_at")
  endedAt            DateTime?        @map("ended_at")

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, startedAt])
  @@map("generation_runs")
}

// ---------- Test runs (§4.5, §4.6) ----------

enum RunStatus {
  queued
  running
  /// Waiting for an LLM to come back; resumes on its own.
  paused
  succeeded
  failed
  aborted
}

model TestRun {
  id       String    @id @default(uuid())
  targetId String    @map("target_id")
  status   RunStatus @default(queued)

  /// Container id while a sandbox is attached; null for api targets.
  sandboxId   String? @map("sandbox_id")
  sandboxName String? @map("sandbox_name")
  /// noVNC url for the shared live view (§4.6).
  viewUrl     String? @map("view_url")

  /// Which LLM configs were in play, captured when the run started.
  llmConfigSnapshot Json?     @map("llm_config_snapshot")
  stepCount         Int       @default(0) @map("step_count")
  inputTokens       Int       @default(0) @map("input_tokens")
  outputTokens      Int       @default(0) @map("output_tokens")
  pausedReason      String?   @map("paused_reason")
  error             String?
  triggeredById     String    @map("triggered_by")
  startedAt         DateTime  @default(now()) @map("started_at")
  endedAt           DateTime? @map("ended_at")

  target   QaTarget       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  queue    RunCaseQueue[]
  steps    RunStep[]
  results  TestResult[]
  findings RunFinding[]

  @@index([targetId, startedAt])
  @@map("test_runs")
}

enum QueueStatus {
  queued
  running
  done
  skipped
}

/// The case list for one run, with each case's version pinned when it starts (§4.5).
model RunCaseQueue {
  runId          String      @map("run_id")
  testCaseId     String      @map("test_case_id")
  /// Null until the case starts; set from the case's current version at that moment.
  caseVersion    Int?        @map("test_case_version")
  status         QueueStatus @default(queued)
  order          Int
  /// True when the case was edited after this run used it (§4.5 done/skipped rule).
  editedAfterUse Boolean     @default(false) @map("edited_after_use")

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([runId, testCaseId])
  @@index([runId, order])
  @@map("run_case_queue")
}

model RunStep {
  id            String   @id @default(uuid())
  runId         String   @map("run_id")
  testCaseId    String?  @map("test_case_id")
  seq           Int
  phase         String
  action        Json
  intent        String   @default("")
  observation   String   @default("")
  /// Object-storage key for the screenshot the model saw.
  screenshotKey String?  @map("screenshot_key")
  result        Json?
  modelUsed     String?  @map("model_used")
  durationMs    Int      @default(0) @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, seq])
  @@map("run_steps")
}

enum Verdict {
  pass
  fail
  blocked
  skipped
}

model TestResult {
  id              String    @id @default(uuid())
  runId           String    @map("run_id")
  testCaseId      String    @map("test_case_id")
  caseVersion     Int       @map("test_case_version")
  verdict         Verdict
  /// Set when the failure looks like the feature changed rather than broke (§4.4).
  possiblyChanged Boolean   @default(false) @map("possibly_changed")
  llmReasoning    String    @default("") @map("llm_reasoning")
  /// { screenshots: string[], httpLogs: [], video: string | null }
  evidence        Json      @default("{}")
  reproSteps      String[]  @map("repro_steps")
  stepCount       Int       @default(0) @map("step_count")
  durationMs      Int       @default(0) @map("duration_ms")
  /// Human review, kept separate from the model's verdict (§4.7).
  humanVerdict    Verdict?  @map("human_verdict")
  humanNote       String?   @map("human_note")
  reviewedById    String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([runId, testCaseId])
  @@index([runId])
  @@map("test_results")
}

enum Severity {
  critical
  major
  minor
  info
}

enum FindingStatus {
  open
  converted_to_case
  converted_to_proposal
  dismissed
}

/// Something wrong noticed during a run that is not about the case being tested (§4.5).
model RunFinding {
  id          String        @id @default(uuid())
  runId       String        @map("run_id")
  testCaseId  String?       @map("test_case_id")
  severity    Severity
  title       String
  description String        @default("")
  evidence    Json          @default("{}")
  featureId   String?       @map("related_feature_id")
  status      FindingStatus @default(open)
  createdAt   DateTime      @default(now()) @map("created_at")

  run     TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@map("run_findings")
}
