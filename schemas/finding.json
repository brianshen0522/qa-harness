{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-harness/finding",
  "title": "finding",
  "description": "An issue discovered during execution that is unrelated to the current case.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "severity", "title", "description", "evidence_refs", "related_feature_ref"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor", "info"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "related_feature_ref": { "type": ["string", "null"] }
  }
}
