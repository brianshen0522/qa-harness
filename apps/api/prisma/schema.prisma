generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

enum UserStatus {
  active
  disabled
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  authProvider String     @map("auth_provider")
  status       UserStatus @default(active)
  isAdmin      Boolean    @default(false) @map("is_admin")
  createdAt    DateTime   @default(now()) @map("created_at")

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  targetMemberships  TargetMember[]
  createdProjects    Project[]

  @@map("users")
}

// ---------- Team / Project ----------

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members  TeamMember[]
  projects Project[]

  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

enum Role {
  viewer
  editor
  owner
}

enum DescriptionSource {
  manual
  discussion
  handoff
}

model Project {
  id                 String   @id @default(uuid())
  teamId             String   @map("team_id")
  name               String
  description        String   @default("")
  descriptionVersion Int      @default(0) @map("description_version")
  createdById        String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  team                Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy           User                        @relation(fields: [createdById], references: [id])
  members             ProjectMember[]
  targets             QaTarget[]
  descriptionVersions ProjectDescriptionVersion[]
  discussion          Discussion?
  attachments         ProjectAttachment[]
  handoffDocuments    HandoffDocument[]
  changeProposals     ChangeProposal[]
  changeLogs          ChangeLog[]
  skills              Skill[]
  mcpServers          McpServer[]

  @@map("projects")
}

model ProjectDescriptionVersion {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  version   Int
  content   String
  source    DescriptionSource
  createdBy String            @map("created_by")
  createdAt DateTime          @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@map("project_description_versions")
}

model ProjectMember {
  projectId String @map("project_id")
  userId    String @map("user_id")
  role      Role

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

// ---------- QA Target ----------

enum TargetKind {
  api
  web
  desktop
}

enum TargetStatus {
  idle
  running
}

model QaTarget {
  id                 String       @id @default(uuid())
  projectId          String       @map("project_id")
  name               String
  kind               TargetKind
  config             Json         @default("{}")
  description        String       @default("")
  descriptionVersion Int          @default(0) @map("description_version")
  status             TargetStatus @default(idle)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentials      TargetCredential[]
  members          TargetMember[]
  discussion       Discussion?
  handoffDocuments HandoffDocument[]
  features         Feature[]
  testCases        TestCase[]
  generationRuns   GenerationRun[]
  testRuns         TestRun[]
  changeProposals  ChangeProposal[]
  changeLogs       ChangeLog[]
  identities       TargetIdentity[]
  explorationRuns  ExplorationRun[]
  apiSetup         ApiSetup?

  @@map("qa_targets")
}

/// A credential the target authenticates with. A `password` credential is a
/// bound login pair (username + password) referenced as {{name.username}} /
/// {{name.password}}; every other type is a single secret referenced as {{name}}.
/// The `description` is shown to the model so it picks the right one by meaning,
/// not by guessing at the name.
model TargetCredential {
  targetId       String         @map("target_id")
  /// Logical name; the reference the model writes as {{name}} / {{name.field}}.
  name           String         @map("key")
  type           CredentialType @default(other)
  description    String         @default("")
  /// Encrypted field values. Paired login → { username, password }; single → { value }.
  fields         Json           @default("{}")
  /// When true, a run may rotate this credential: if a case changes its secret on
  /// the target (e.g. a password change), the harness generates the new value and
  /// syncs the stored credential to it. Off by default — opt in per credential.
  allowRotation  Boolean        @default(false) @map("allow_rotation")

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([targetId, name])
  @@map("qa_target_credentials")
}

enum CredentialType {
  password
  api_key
  bearer_token
  cookie
  other
}

/// Role override — only ever >= the member's project role (enforced in service layer).
model TargetMember {
  targetId String @map("target_id")
  userId   String @map("user_id")
  role     Role

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([targetId, userId])
  @@map("qa_target_members")
}

// ---------- LLM ----------

enum LlmProvider {
  anthropic
  openai
  ollama
}

enum LlmPurpose {
  discuss
  generate
  execute
}

/// Circuit-breaker state. `down` configs are skipped when picking a chain and
/// are re-probed on a schedule until they answer again.
enum LlmHealth {
  healthy
  degraded
  down
}

model LlmConfig {
  id              String       @id @default(uuid())
  name            String
  provider        LlmProvider
  endpoint        String?
  apiKeyEncrypted String?      @map("api_key")
  model           String
  purposes        LlmPurpose[]
  supportsVision  Boolean      @default(false) @map("supports_vision")
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  health              LlmHealth @default(healthy)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  downSince           DateTime? @map("down_since")
  lastFailureAt       DateTime? @map("last_failure_at")
  lastFailureKind     String?   @map("last_failure_kind")
  lastFailureMessage  String?   @map("last_failure_message")
  lastProbeAt         DateTime? @map("last_probe_at")
  /// Probes back off while a config stays down; reset the moment it recovers.
  nextProbeAt         DateTime? @map("next_probe_at")
  probeAttempts       Int       @default(0) @map("probe_attempts")
  lastRecoveredAt     DateTime? @map("last_recovered_at")

  fallbackEntries LlmFallbackChain[]

  @@map("llm_configs")
}

model LlmFallbackChain {
  purpose     LlmPurpose
  llmConfigId String     @map("llm_config_id")
  order       Int

  llmConfig LlmConfig @relation(fields: [llmConfigId], references: [id], onDelete: Cascade)

  @@id([purpose, llmConfigId])
  @@map("llm_fallback_chains")
}

/// One row per LLM call, for usage accounting and debugging fallbacks.
model LlmCallLog {
  id           String     @id @default(uuid())
  purpose      LlmPurpose
  schemaName   String?    @map("schema_name")
  llmConfigId  String?    @map("llm_config_id")
  projectId    String?    @map("project_id")
  targetId     String?    @map("target_id")
  model        String
  attempt      Int
  outcome      String // ok | invalid_output | provider_error | timeout | rate_limit
  errorMessage String?    @map("error_message")
  rawOutput    String?    @map("raw_output")
  inputTokens  Int?       @map("input_tokens")
  outputTokens Int?       @map("output_tokens")
  durationMs   Int        @map("duration_ms")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("llm_call_logs")
}

// ---------- Sandbox / Audit ----------

model SandboxSettings {
  id              Int     @id @default(1)
  image           String  @default("qa-harness-sandbox:0.5")
  cpu             Float   @default(2)
  memoryMb        Int     @default(4096) @map("memory_mb")
  resolution      String  @default("1280x800")
  maxConcurrent   Int     @default(2) @map("max_concurrent")
  maxStepsPerCase Int     @default(60) @map("max_steps_per_case")
  /// How many api-target cases run concurrently in one QA run (1 = sequential). §4.6
  apiConcurrency  Int     @default(4) @map("api_concurrency")
  stepTimeoutSec  Int     @default(60) @map("step_timeout")
  retentionDays   Int     @default(30) @map("retention_days")
  /// Record the screen for each case. Off makes runs cheaper on disk (§4.7 錄影).
  recordVideo     Boolean @default(true) @map("record_video")

  @@map("sandbox_settings")
}

enum ActorType {
  admin
  user
}

model AuditLog {
  id        String    @id @default(uuid())
  actorType ActorType @map("actor_type")
  actorId   String    @map("actor_id")
  action    String
  target    String?
  payload   Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Discussion (§4.1) ----------

enum Scope {
  project
  target
}

enum DiscussionRole {
  user
  assistant
}

/// One guided-discussion thread per Project and per Target.
model Discussion {
  id           String   @id @default(uuid())
  scope        Scope
  projectId    String?  @unique @map("project_id")
  targetId     String?  @unique @map("target_id")
  /// { checklistItemKey: "unknown" | "partial" | "clear" }
  completeness Json     @default("{}")
  /// Working description draft, editable by the user and patched by the LLM.
  draft        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project   Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target    QaTarget?           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  messages  DiscussionMessage[]
  proposals TargetProposal[]

  @@map("discussions")
}

model DiscussionMessage {
  id           String         @id @default(uuid())
  discussionId String         @map("discussion_id")
  role         DiscussionRole
  content      String
  /// Full `discussion_turn` payload for assistant messages.
  structured   Json?
  /// URLs fetched for this message: [{ url, title, chars, error }]
  references   Json?
  llmConfigId  String?        @map("llm_config_id")
  model        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId, createdAt])
  @@map("discussion_messages")
}

enum ProposalStatus {
  pending
  accepted
  rejected
}

/// LLM-suggested QA Target. Never applied automatically — a user must accept it.
model TargetProposal {
  id              String         @id @default(uuid())
  discussionId    String         @map("discussion_id")
  messageId       String?        @map("message_id")
  kind            TargetKind
  name            String
  config          Json           @default("{}")
  credentialKeys  String[]       @map("credential_keys")
  rationale       String         @default("")
  status          ProposalStatus @default(pending)
  createdTargetId String?        @map("created_target_id")
  decidedById     String?        @map("decided_by")
  decidedAt       DateTime?      @map("decided_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@map("target_proposals")
}

enum AttachmentSource {
  url
  file
  handoff
}

/// Reference material gathered in the discussion area (§4.1).
model ProjectAttachment {
  id           String           @id @default(uuid())
  projectId    String           @map("project_id")
  sourceType   AttachmentSource @map("source_type")
  filename     String
  mime         String           @default("text/plain")
  url          String?
  storageKey   String?          @map("storage_key")
  /// Extracted text, used as LLM context.
  textContent  String?          @map("text_content")
  byteSize     Int              @default(0) @map("byte_size")
  uploadedById String           @map("uploaded_by")
  createdAt    DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_attachments")
}

// ---------- Context Handoff (§4.2) ----------

enum HandoffApplyMode {
  overwrite
  merge
  attachment
}

model HandoffDocument {
  id                          String           @id @default(uuid())
  scope                       Scope
  projectId                   String?          @map("project_id")
  targetId                    String?          @map("target_id")
  rawContent                  String           @map("raw_content")
  /// Parsed `handoff_document` payload (front-matter + sections + extras).
  parsed                      Json
  harnessVersion              String           @map("harness_version")
  applyMode                   HandoffApplyMode @map("apply_mode")
  importedById                String           @map("imported_by")
  importedAt                  DateTime         @default(now()) @map("imported_at")
  appliedToDescriptionVersion Int?             @map("applied_to_description_version")

  project Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  QaTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([projectId, importedAt])
  @@index([targetId, importedAt])
  @@map("handoff_documents")
}

// ---------- Features & test cases (§4.3) ----------

enum FeatureStatus {
  active
  removed
}

model Feature {
  id                        String        @id @default(uuid())
  targetId                  String        @map("target_id")
  name                      String
  description               String        @default("")
  status                    FeatureStatus @default(active)
  /// Description version this feature was derived from, so staleness is visible.
  basedOnDescriptionVersion Int           @default(0) @map("based_on_description_version")
  order                     Int           @default(0)
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  target    QaTarget      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  findings  RunFinding[]
  apiSetup  FeatureSetup?

  @@unique([targetId, name])
  @@index([targetId, order])
  @@map("features")
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum CaseType {
  happy
  edge
  negative
}

enum CaseSource {
  generated
  manual
  change_proposal
  finding
}

/// active runs by default; outdated needs review after a change; deprecated is history.
enum CaseStatus {
  active
  outdated
  deprecated
}

model TestCase {
  id                        String     @id @default(uuid())
  targetId                  String     @map("target_id")
  featureId                 String?    @map("feature_id")
  title                     String
  precondition              String     @default("")
  /// Data/state the case needs set up beforehand that a single automated run
  /// cannot create (e.g. "a DISABLED account must exist"). Shown to the agent and
  /// surfaced when the case is blocked, so it is clear what to prepare.
  setupNote                 String     @default("") @map("setup_note")
  /// string[] — the steps an executor follows.
  steps                     Json       @default("[]")
  expected                  String
  priority                  Priority   @default(P2)
  type                      CaseType   @default(happy)
  source                    CaseSource @default(generated)
  status                    CaseStatus @default(active)
  currentVersion            Int        @default(1) @map("current_version")
  order                     Int        @default(0)
  basedOnDescriptionVersion Int        @default(0) @map("based_on_description_version")
  createdById               String?    @map("created_by")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  target    QaTarget          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  feature   Feature?          @relation(fields: [featureId], references: [id], onDelete: SetNull)
  versions  TestCaseVersion[]
  queueRows RunCaseQueue[]
  results   TestResult[]

  @@index([targetId, order])
  @@index([targetId, status])
  @@index([featureId])
  @@map("test_cases")
}

/// API 前置流程(§4.4 延伸):在一趟 run 開始時「執行一次」的一組請求,把 login token
/// 這類「執行期才知道」的值擷取成具名變數,供該 run 的每一條 case 以 {{名稱}} 取用。
/// 把「共用步驟(login→token)」和「測試(各種變體)」拆成兩個概念:前者放這裡跑一次,
/// 後者留在 TestCase,只描述差異與預期。
model ApiSetup {
  id        String   @id @default(uuid())
  targetId  String   @unique @map("target_id")
  /// SetupStep[]:{ label, request:{method,path,headers,query,body}, captures:[{name, from}] }
  /// from 是回應裡的取值路徑,如 `body.access_token`、`status`、`headers.location`。
  steps     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@map("api_setups")
}

/// Feature 層級的前置流程(§4.4):只在「這個 feature 的第一條 case 執行前」跑一次,
/// 擷取的變數只給該 feature 的 case 使用。適合「先建一筆資料、再測它的各種操作」這類
/// feature 專屬前置,與 Target 層級(全站共用,如 login)並存。
model FeatureSetup {
  id        String   @id @default(uuid())
  featureId String   @unique @map("feature_id")
  steps     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@map("feature_setups")
}

model TestCaseVersion {
  id         String   @id @default(uuid())
  testCaseId String   @map("test_case_id")
  version    Int
  /// Full snapshot of the case at this version.
  content    Json
  changeId   String?  @map("change_id")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, version])
  @@map("test_case_versions")
}

// ---------- Generation pipeline (§4.3) ----------

enum GenerationStatus {
  running
  /// Waiting for an LLM to come back; resumes on its own.
  paused
  succeeded
  failed
}

enum GenerationMode {
  replace
  append
}

model GenerationRun {
  id                 String           @id @default(uuid())
  targetId           String           @map("target_id")
  status             GenerationStatus @default(running)
  mode               GenerationMode
  descriptionVersion Int              @map("description_version")
  featureCount       Int              @default(0) @map("feature_count")
  caseCount          Int              @default(0) @map("case_count")
  duplicatesDropped  Int              @default(0) @map("duplicates_dropped")
  /// Summary of what 現況探索 found, shown in the UI.
  discovery          Json?
  model              String?
  error              String?
  /// Why the run is paused, shown to the user while it waits.
  pausedReason       String?          @map("paused_reason")
  pausedAt           DateTime?        @map("paused_at")
  /// Partial results, so a paused run picks up where it stopped.
  progress           Json?
  /// When set, only these features are regenerated (§4.4 只針對受影響 feature 重生成).
  onlyFeatureIds     String[]         @map("only_feature_ids")
  triggeredById      String           @map("triggered_by")
  startedAt          DateTime         @default(now()) @map("started_at")
  endedAt            DateTime?        @map("ended_at")

  target QaTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, startedAt])
  @@map("generation_runs")
}

// ---------- Test runs (§4.5, §4.6) ----------

enum RunStatus {
  queued
  running
  /// Waiting for an LLM to come back; resumes on its own.
  paused
  succeeded
  failed
  aborted
  /// Cut short by the environment (API restart, or the system was unreachable) —
  /// not a test failure. Completed case results are kept; the rest can be re-run.
  interrupted
}

model TestRun {
  id       String    @id @default(uuid())
  targetId String    @map("target_id")
  status   RunStatus @default(queued)

  /// Container id while a sandbox is attached; null for api targets.
  sandboxId   String? @map("sandbox_id")
  sandboxName String? @map("sandbox_name")
  /// noVNC url for the shared live view (§4.6).
  viewUrl     String? @map("view_url")

  /// Which LLM configs were in play, captured when the run started.
  llmConfigSnapshot Json?     @map("llm_config_snapshot")
  /// What was actually used: calls and failures per config, plus every moment
  /// the chain fell over to the next one (§4.7 「含 fallback 切換紀錄」).
  llmUsage          Json?     @map("llm_usage")
  stepCount         Int       @default(0) @map("step_count")
  inputTokens       Int       @default(0) @map("input_tokens")
  outputTokens      Int       @default(0) @map("output_tokens")
  pausedReason      String?   @map("paused_reason")
  error             String?
  triggeredById     String    @map("triggered_by")
  startedAt         DateTime  @default(now()) @map("started_at")
  endedAt           DateTime? @map("ended_at")
  /// Set once retention has removed this run's screenshots (§5.1).
  evidencePurgedAt  DateTime? @map("evidence_purged_at")

  target   QaTarget       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  queue    RunCaseQueue[]
  steps    RunStep[]
  results  TestResult[]
  findings RunFinding[]

  @@index([targetId, startedAt])
  @@map("test_runs")
}

enum QueueStatus {
  queued
  running
  done
  skipped
}

/// The case list for one run, with each case's version pinned when it starts (§4.5).
model RunCaseQueue {
  runId          String      @map("run_id")
  testCaseId     String      @map("test_case_id")
  /// Null until the case starts; set from the case's current version at that moment.
  caseVersion    Int?        @map("test_case_version")
  status         QueueStatus @default(queued)
  order          Int
  /// True when the case was edited after this run used it (§4.5 done/skipped rule).
  editedAfterUse Boolean     @default(false) @map("edited_after_use")

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([runId, testCaseId])
  @@index([runId, order])
  @@map("run_case_queue")
}

model RunStep {
  id            String   @id @default(uuid())
  runId         String   @map("run_id")
  testCaseId    String?  @map("test_case_id")
  seq           Int
  phase         String
  action        Json
  intent        String   @default("")
  observation   String   @default("")
  /// Object-storage key for the screenshot the model saw.
  screenshotKey String?  @map("screenshot_key")
  result        Json?
  modelUsed     String?  @map("model_used")
  durationMs    Int      @default(0) @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, seq])
  @@map("run_steps")
}

enum Verdict {
  pass
  fail
  blocked
  skipped
}

model TestResult {
  id              String    @id @default(uuid())
  runId           String    @map("run_id")
  testCaseId      String    @map("test_case_id")
  caseVersion     Int       @map("test_case_version")
  verdict         Verdict
  /// Set when the failure looks like the feature changed rather than broke (§4.4).
  possiblyChanged Boolean   @default(false) @map("possibly_changed")
  llmReasoning    String    @default("") @map("llm_reasoning")
  /// { screenshots: string[], httpLogs: [], video: string | null }
  evidence        Json      @default("{}")
  reproSteps      String[]  @map("repro_steps")
  stepCount       Int       @default(0) @map("step_count")
  durationMs      Int       @default(0) @map("duration_ms")
  /// Human review, kept separate from the model's verdict (§4.7).
  humanVerdict    Verdict?  @map("human_verdict")
  humanNote       String?   @map("human_note")
  reviewedById    String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([runId, testCaseId])
  @@index([runId])
  @@map("test_results")
}

enum Severity {
  critical
  major
  minor
  info
}

enum FindingStatus {
  open
  converted_to_case
  converted_to_proposal
  dismissed
}

/// Something wrong noticed during a run that is not about the case being tested (§4.5).
model RunFinding {
  id                  String        @id @default(uuid())
  runId               String        @map("run_id")
  testCaseId          String?       @map("test_case_id")
  severity            Severity
  title               String
  description         String        @default("")
  evidence            Json          @default("{}")
  featureId           String?       @map("related_feature_id")
  status              FindingStatus @default(open)
  /// What this finding turned into, so the results page can link to it.
  convertedCaseId     String?       @map("converted_case_id")
  convertedProposalId String?       @map("converted_proposal_id")
  createdAt           DateTime      @default(now()) @map("created_at")

  run     TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([status])
  @@map("run_findings")
}

// ---------- Change management (§4.4) ----------

/// Where a proposal came from, so a stale description can be traced to its origin.
enum ChangeSource {
  discussion
  handoff
  manual
  run_detection
  finding
}

enum ProposalState {
  pending
  applied
  rejected
}

/// The LLM only ever proposes; nothing here touches the live test list until a
/// person accepts it, and they can accept part of it.
model ChangeProposal {
  id        String        @id @default(uuid())
  scope     Scope
  projectId String?       @map("project_id")
  targetId  String?       @map("target_id")
  source    ChangeSource
  state     ProposalState @default(pending)
  summary   String        @default("")

  /// Human-readable diff of the description, and the text that would replace it.
  descriptionDiff  String  @default("") @map("description_diff")
  descriptionAfter String  @default("") @map("description_after")
  /// Each entry carries its own id, so decisions reference items not positions.
  featureChanges   Json    @default("[]") @map("feature_changes")
  testCaseChanges  Json    @default("[]") @map("test_case_changes")
  /// What prompted it: a discussion excerpt, a run id, a finding id.
  originNote       String? @map("origin_note")
  model            String?

  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  decidedById String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")

  project Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target  QaTarget?   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  logs    ChangeLog[]

  @@index([projectId, createdAt])
  @@index([targetId, createdAt])
  @@map("change_proposals")
}

/// The timeline (§4.4): what changed, when, by whom, and what it touched.
model ChangeLog {
  id         String       @id @default(uuid())
  proposalId String       @map("proposal_id")
  scope      Scope
  projectId  String?      @map("project_id")
  targetId   String?      @map("target_id")
  source     ChangeSource

  summary                 String
  descriptionVersionAfter Int?     @map("description_version_after")
  affectedFeatureIds      String[] @map("affected_feature_ids")
  affectedTestCaseIds     String[] @map("affected_test_case_ids")
  /// Per-item outcome, so a rejected item is still visible in the history.
  decisions               Json     @default("{}")

  appliedById String   @map("applied_by")
  appliedAt   DateTime @default(now()) @map("applied_at")

  proposal ChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target   QaTarget?      @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([projectId, appliedAt])
  @@index([targetId, appliedAt])
  @@map("change_logs")
}

// ---------- Explore-first mode (§4.3 探索優先) ----------

/// A named "who is using the system" — a role plus the credential fields that
/// log it in. Explicit identities are what make the permission matrix possible:
/// the crawler runs once per identity, and access is compared, not guessed.
model TargetIdentity {
  id             String   @id @default(uuid())
  targetId       String   @map("target_id")
  name           String
  /// Free-form role label the model reasons with (e.g. "admin", "member", "guest").
  role           String   @default("user")
  /// Names of the target credentials that log this identity in ({{name}} refs).
  credentialKeys String[] @map("credential_keys")
  /// How to authenticate in the browser, when it is not the default form flow.
  loginConfig    Json     @default("{}") @map("login_config")
  /// A guest identity crawls without logging in at all.
  isAnonymous    Boolean  @default(false) @map("is_anonymous")
  order          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  target       QaTarget          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  observations SiteObservation[]

  @@unique([targetId, name])
  @@map("target_identities")
}

enum ExplorationStatus {
  running
  paused
  succeeded
  failed
}

enum ExplorationPhase {
  crawl
  rwd
  synthesis
}

/// One full sweep of a target: crawl per identity, RWD scan, then synthesis.
model ExplorationRun {
  id            String            @id @default(uuid())
  targetId      String            @map("target_id")
  status        ExplorationStatus @default(running)
  /// Budgets, breakpoints, depth cap, whether to do deep agent dives — the knobs.
  config        Json              @default("{}")
  /// Live progress, so a paused run resumes and a late viewer can catch up.
  progress      Json?
  pausedReason  String?           @map("paused_reason")
  error         String?
  /// Counts and the coverage summary, filled in as it goes.
  stats         Json              @default("{}")
  /// How many model calls the deep-探索 and synthesis stages have spent.
  llmCalls      Int               @default(0) @map("llm_calls")
  triggeredById String            @map("triggered_by")
  startedAt     DateTime          @default(now()) @map("started_at")
  endedAt       DateTime?         @map("ended_at")

  target       QaTarget          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  nodes        SiteNode[]
  edges        SiteEdge[]
  observations SiteObservation[]

  @@index([targetId, startedAt])
  @@map("exploration_runs")
}

/// One normalized route in the site map. `/todos/1` and `/todos/2` collapse to
/// `/todos/:id`, or the crawl never ends.
model SiteNode {
  id          String   @id @default(uuid())
  runId       String   @map("run_id")
  /// Normalized path with dynamic segments turned into :params.
  routeKey    String   @map("route_key")
  /// A representative concrete path that reached this node.
  sampleUrl   String   @map("sample_url")
  title       String   @default("")
  /// Which identities could reach this node at all (permission matrix, §4.4-ish).
  reachableBy String[] @map("reachable_by")
  /// role labels that got an explicit "denied / redirected to login" here.
  deniedFor   String[] @map("denied_for")
  kind        String   @default("page")
  depth       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  run          ExplorationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  observations SiteObservation[]
  outEdges     SiteEdge[]        @relation("edge_from")
  inEdges      SiteEdge[]        @relation("edge_to")

  @@unique([runId, routeKey])
  @@index([runId])
  @@map("site_nodes")
}

/// A link or control that led from one node to another.
model SiteEdge {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  fromId    String   @map("from_id")
  toId      String?  @map("to_id")
  /// "link" | "control" | "form" — how the transition happens.
  kind      String   @default("link")
  label     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  run  ExplorationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  from SiteNode       @relation("edge_from", fields: [fromId], references: [id], onDelete: Cascade)
  to   SiteNode?      @relation("edge_to", fields: [toId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@map("site_edges")
}

enum ObservationKind {
  page_snapshot
  rwd_issue
  access_denied
  access_granted
  finding
  deep_note
}

/// Everything learned about one node, by one identity, at one breakpoint: the
/// DOM probe, a screenshot, an RWD problem, an access result, a stray finding.
model SiteObservation {
  id            String          @id @default(uuid())
  runId         String          @map("run_id")
  nodeId        String?         @map("node_id")
  identityId    String?         @map("identity_id")
  kind          ObservationKind
  /// e.g. "1280x800" for a viewport, null when not size-specific.
  breakpoint    String?
  /// The DOM probe, layout metrics, or finding detail — shape depends on kind.
  data          Json            @default("{}")
  screenshotKey String?         @map("screenshot_key")
  /// critical/major/minor/info for rwd_issue and finding kinds.
  severity      String?
  note          String          @default("")
  createdAt     DateTime        @default(now()) @map("created_at")

  run      ExplorationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node     SiteNode?       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  identity TargetIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([runId, kind])
  @@index([nodeId])
  @@map("site_observations")
}

// ---------- Skills (§3.2 / §4.8): reusable instructions injected into LLM prompts ----------

enum SkillScope {
  global
  project
}

/// A named block of markdown guidance ("always check the cart badge updates",
/// "our dates are DD/MM/YYYY") folded into the system prompt of generation and
/// execution, so house rules do not have to be repeated in every description.
model Skill {
  id        String     @id @default(uuid())
  scope     SkillScope @default(global)
  projectId String?    @map("project_id")
  name      String
  content   String     @default("")
  enabled   Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, enabled])
  @@index([projectId])
  @@map("skills")
}

// ---------- MCP servers (§3.2 / §6.2): external tool providers for worker + discussion ----------

enum McpScope {
  global
  project
}

/// A Model Context Protocol server the agent can call tools on. Auth is stored
/// encrypted like a credential; the value never leaves the server or reaches a prompt.
model McpServer {
  id            String    @id @default(uuid())
  scope         McpScope  @default(global)
  projectId     String?   @map("project_id")
  name          String
  url           String
  /// Encrypted bearer/token header value, or empty for an open server.
  authEncrypted String?   @map("auth_encrypted")
  enabled       Boolean   @default(true)
  /// Cached tool list from the last successful connection, for display.
  toolsCache    Json      @default("[]") @map("tools_cache")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, enabled])
  @@index([projectId])
  @@map("mcp_servers")
}
